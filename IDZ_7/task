#include <iostream>
using namespace std;

int board[8];
int count = 0;

bool isSafe(int row, int col) {
    for (int i = 0; i < row; i++) {
        if (board[i] == col || 
            board[i] - i == col - row || 
            board[i] + i == col + row) {
            return false;
        }
    }
    return true;
}

void solve(int row) {
    if (row == 8) {
        count++;
        cout << "Решение " << count << ": ";
        for (int i = 0; i < 8; i++) {
            cout << board[i] + 1 << " ";
        }
        cout << endl;
        return;
    }

    for (int col = 0; col < 8; col++) {
        if (isSafe(row, col)) {
            board[row] = col;
            solve(row + 1);
        }
    }
}

int main() {
    cout << "Все расстановки 8 ферзей (всего 92):" << endl;
    solve(0);
    cout << "Всего решений: " << count << endl;
    return 0;
}
